# Mix-GEM Development Stack - Environment Configuration
# Usage: docker-compose -f docker-compose.dev.yml --env-file .env.dev up
# All services enabled by default - no profiles needed

# ============================================================================
# Core Infrastructure
# ============================================================================

# PostgreSQL Database (development defaults)
POSTGRES_DB=mixgem_dev
POSTGRES_USER=mixgem
POSTGRES_PASSWORD=dev_password_change_in_prod
POSTGRES_PORT=5432
POSTGRES_HOST_AUTH_METHOD=md5

# Redis
REDIS_PORT=6379

# ============================================================================
# Ollama - Local LLM
# ============================================================================

OLLAMA_PORT=11434

# ============================================================================
# RAG Engine
# ============================================================================

# API Keys (optional for dev - uses local Ollama models)
ANTHROPIC_API_KEY=

# RAG Configuration (using fast local models for dev)
RAG_PORT=8001
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=llama3.2:3b

# ============================================================================
# Scavenger - SECS/GEM Ingestion
# ============================================================================

# Scavenger API
SCAVENGER_PORT=8000

# OpenAI (optional)
OPENAI_API_KEY=

# SECS/GEM Simulator
HSMS_PASSIVE_PORT=5000
HSMS_ACTIVE_PORT=5001
HSMS_DEVICE_ID=1
EQUIPMENT_ID=LITHO_DEV

# Scavenger Recorder (smaller batches for dev)
BATCH_SIZE=50
FLUSH_INTERVAL_MS=500

# ============================================================================
# Monitoring Stack
# ============================================================================

# Prometheus
PROMETHEUS_PORT=9090

# Grafana (dev-friendly settings)
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3001
GRAFANA_LOG_LEVEL=debug

# Exporters
NODE_EXPORTER_PORT=9100
POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121
CADVISOR_PORT=8080

# ============================================================================
# Development Tools
# ============================================================================

# pgAdmin
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@mixgem.dev
PGADMIN_PASSWORD=admin

# Redis Commander
REDIS_COMMANDER_PORT=8081

# ============================================================================
# General Settings
# ============================================================================

# Logging (verbose for development)
LOG_LEVEL=DEBUG

# Environment
NODE_ENV=development
