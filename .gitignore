site/

# Package manager locks (keep for reproducibility, but can be excluded if preferred)
# package-lock.json
# yarn.lock
# poetry.lock
# Pipfile.lock

# Archive files (if not needed)
*.zip
*.tar
*.tar.gz
*.rar
*.7z

