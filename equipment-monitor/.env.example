# Mix-GEM Production Stack - Environment Configuration Template
# Copy this file to .env and update with your values
# IMPORTANT: Never commit .env to version control

# ============================================================================
# Core Infrastructure
# ============================================================================

# PostgreSQL Database
POSTGRES_DB=mixgem
POSTGRES_USER=mixgem
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS_MIN
POSTGRES_PORT=5432
POSTGRES_HOST_AUTH_METHOD=scram-sha-256

# PostgreSQL Performance Tuning
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_WORK_MEM=64MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
POSTGRES_MAX_CONNECTIONS=200

# Redis
REDIS_PORT=6379

# ============================================================================
# Ollama - Local LLM (profile: ollama)
# ============================================================================

OLLAMA_PORT=11434

# ============================================================================
# RAG Engine (profile: rag)
# ============================================================================

# API Keys (REQUIRED for RAG profile)
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# RAG Configuration
RAG_PORT=8001
EMBEDDING_MODEL=snowflake-arctic-embed2
LLM_MODEL=claude-sonnet-4-20250514

# ============================================================================
# Scavenger - SECS/GEM Ingestion (profile: scavenger)
# ============================================================================

# Scavenger API
SCAVENGER_PORT=8000

# OpenAI (optional for Scavenger)
OPENAI_API_KEY=

# SECS/GEM Simulator
HSMS_PASSIVE_PORT=5000
HSMS_ACTIVE_PORT=5001
HSMS_DEVICE_ID=1
EQUIPMENT_ID=LITHO01

# Scavenger Recorder
BATCH_SIZE=100
FLUSH_INTERVAL_MS=1000

# ============================================================================
# Monitoring Stack (profile: monitoring)
# ============================================================================

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
GRAFANA_ROOT_URL=http://localhost:3001
GRAFANA_LOG_LEVEL=info
GRAFANA_INSTALL_PLUGINS=

# Exporters
NODE_EXPORTER_PORT=9100
POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121
CADVISOR_PORT=8080

# ============================================================================
# Gateway Stack (profile: gateway)
# ============================================================================

# Nginx
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Certbot - Let's Encrypt (REQUIRED for gateway profile in production)
CERTBOT_EMAIL=admin@example.com
CERTBOT_DOMAIN=example.com

# ============================================================================
# Backup Service (profile: backup)
# ============================================================================

BACKUP_RETENTION_DAYS=30

# ============================================================================
# General Settings
# ============================================================================

# Logging
LOG_LEVEL=INFO

# ============================================================================
# Profile Selection
# ============================================================================
# Use COMPOSE_PROFILES to enable service groups
# Examples:
#   COMPOSE_PROFILES=scavenger,monitoring,gateway
#   COMPOSE_PROFILES=rag,ollama,monitoring
#   COMPOSE_PROFILES=simulator,monitoring

COMPOSE_PROFILES=scavenger,monitoring

# ============================================================================
# Development vs Production
# ============================================================================
# Set to 'production' to enable stricter settings
NODE_ENV=production
