# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 3D assets — equipment + infrastructure GLBs are tracked (optimized via gltf-transform)
# Character + accessory GLBs are tracked (small, needed for GitHub Pages)
# /public/models/character/*.glb
# /public/models/accessory/*.glb
/public/env/*.env
/vendor/grabcad/*.step
# Raw Meshy downloads — huge (24 MB–484 MB), optimized into clean names via
# scripts/optimize-meshy-batch.sh. Never tracked or shipped to GitHub Pages.
# Scoped to the equipment folder only — character/ keeps its tracked
# Meshy_AI_Animation_*_withSkin.glb avatars (needed at runtime on GitHub Pages).
/vendor/meshy-raw/
/public/models/equipment/Meshy_AI_*.glb
/CREDITS.md
.gstack/
