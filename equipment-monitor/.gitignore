# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 3D assets (large equipment models re-fetched by npm run assets:refresh)
/public/models/equipment/*.glb
# Character + accessory GLBs are tracked (small, needed for GitHub Pages)
# /public/models/character/*.glb
# /public/models/accessory/*.glb
/public/env/*.env
/vendor/grabcad/*.step
/CREDITS.md
