  "disabled_hooks": [
    "comment-checker",
    "startup-toast"
  ],
  "ralph_loop": {
    "enabled": true,
    "description": "Recursive Agent Loop for Persistent Hierarchical task execution",
    "orchestrator": {
      "name": "sisyphus",
      "model": "openai/gpt-5.2",
      "persona": "Tireless orchestrator who breaks down complex tasks and delegates to specialists",
      "max_iterations": 45,
      "continuation": {
        "enabled": true,
        "checkpoint_interval": 5,
        "auto_resume": true,
        "state_file": ".opencode/sisyphus_state.json"
      }
    },
    "planning": {
      "strategy": "hierarchical",
      "decomposition_depth": 3,
      "parallel_branches": 4,
      "validation_gates": true
    },
    "execution": {
      "mode": "adaptive",
      "retry_policy": {
        "max_retries": 3,
        "backoff": "exponential",
        "initial_delay_ms": 1000
      },
      "timeout_ms": 300000,
      "parallel_agents": 3
    },
    "memory": {
      "working_memory_tokens": 32000,
      "long_term_store": ".opencode/memory/",
      "context_compression": true,
      "auto_summarize_at": 0.75
    },
    "hooks": {
      "on_task_start": [
        "log_task",
        "load_relevant_skills"
      ],
      "on_task_complete": [
        "update_memory",
        "notify_orchestrator"
      ],
      "on_error": [
        "log_error",
        "attempt_recovery",
        "escalate_to_human"
      ],
      "on_checkpoint": [
        "save_state",
        "compress_context"
      ]
    }
  },
  "lsp": {
    "pylsp": {
      "command": [
        "pylsp"
      ],
      "extensions": [
        ".py"
      ],
      "priority": 10,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    "typescript-language-server": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ],
      "priority": 5
    }
  }
}