{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "google_auth": false,
  "sisyphus_agent": {
    "default_builder_enabled": true
  },
  "background_task": {
    "defaultConcurrency": 9,
    "providerConcurrency": {
      "anthropic": 3,
      "openai": 3,
      "google": 9
    },
    "modelConcurrency": {
      "google/antigravity-claude-opus-4-5-thinking": 1,
      "google/antigravity-claude-sonnet-4-5-thinking": 2,
      "google/antigravity-claude-sonnet-4-5": 3,
      "anthropic/claude-opus-4-5": 1,
      "anthropic/claude-sonnet-4-5": 2,
      "google/antigravity-gemini-3-pro-high": 1,
      "google/antigravity-gemini-3-flash": 5,
      "openai/gpt-5.2": 2,
      "openai/gpt-5.2-codex": 2,
      "google/gemini-3-flash": 3
    }
  },
  "categories": {
    "secs-gem-protocol": {
      "description": "Implement HSMS/SECS-II/GEM stream and function.",
      "variant": "high",
      "model": "google/antigravity-gemini-3-flash",
      "temperature": 0.3,
      "prompt_append": "Always use secs-gem-open-source-docs skill. Focus on HSMS/SECS-II/GEM correctness, timeouts, state models, and deterministic traceability."
    },
    "lithography": {
      "description": "Implement lithography workflow and golden recipe management.",
      "variant": "high",
      "model": "google/antigravity-gemini-3-flash",
      "temperature": 0.45,
      "prompt_append": "Always use lithography-expert skill. Focus on lithography correctness, timeouts, state models, and deterministic traceability."
    },
    "rag-expert": {
      "description": "Implement ACE Context Pack builder + Agentic RAG orchestration + evidence-chain and evaluation loop.",
      "variant": "high",
      "model": "google/antigravity-gemini-3-flash",
      "temperature": 0.7,
      "prompt_append": "Always use ollama-rag and pgvector-setup skills. Focus on Agentic RAG and Agentic Context Engineering, vector database correctness."
    },
    "backend": {
      "description": "Implement backend services and database migrations.",
      "model": "google/antigravity-claude-sonnet-4-5",
      "variant": "max",
      "temperature": 0.1,
      "prompt_append": "Always use fastapi-patterns and asyncio-concurrency-patterns and postgresql-master skills. Focus on FastAPI contracts, Postgres migrations, and streaming endpoints with tests."
    },
    "business-logic": {
      "description": "Implement business logic and tests.",
      "model": "openai/gpt-5.2",
      "variant": "xhigh",
      "temperature": 0.3,
      "prompt_append": "Always use postgresql-master skill. Focus on business logic contracts, Postgres migrations, and streaming endpoints with tests."
    },
    "docker-compose": {
      "description": "Implement docker-compose.yml and dockerfile.",
      "model": "opencode/minimax-m2.1-free",
      "temperature": 0.45,
      "prompt_append": "Always use docker-compose-generator skill. Focus on dockerfile contracts, and docker-compose.yml with tests."
    },
    "visual": {
      "description": "Implement UI/UX contracts, visual design, and visual design with tests.",
      "model": "opencode/minimax-m2.1-free",
      "temperature": 0.9,
      "prompt_append": "Always use ui-ux-pro-max skill. Focus on UI/UX contracts, visual design, and visual design with tests."
    }
  },
  "agents": {
    "sisyphus": {
      "model": "google/antigravity-claude-opus-4-5-thinking",
      "variant": "max",
      "temperature": 0.1
    },
    "oracle": {
      "variant": "high",
      "model": "google/antigravity-gemini-3-pro",
      "temperature": 0.3
    },
    "librarian": {
      "model": "google/antigravity-claude-sonnet-4-5-thinking",
      "variant": "max",
      "temperature": 0.3
    },
    "explore": {
      "model": "google/antigravity-gemini-3-flash",
      "variant": "high",
      "temperature": 0.45
    },
    "atlas": {
      "model": "google/antigravity-gemini-3-flash",
      "variant": "high",
      "temperature": 0.1
    },
    "OpenCode-Builder": {
      "model": "openai/gpt-5.2",
      "variant": "xhigh",
      "temperature": 0.3
    },
    "prometheus": {
      "model": "google/antigravity-claude-opus-4-5-thinking",
      "variant": "max",
      "temperature": 0.45
    },
    "metis": {
      "model": "google/antigravity-claude-sonnet-4-5-thinking",
      "variant": "max",
      "temperature": 0.3
    },
    "momus": {
      "model": "google/antigravity-gemini-3-pro",
      "variant": "high",
      "temperature": 0.1
    },
    "multimodal-looker": {
      "variant": "high",
      "model": "google/antigravity-gemini-3-pro"
    }
  },
  "disabled_hooks": [
    "comment-checker",
    "startup-toast"
  ],
  "ralph_loop": {
    "enabled": true,
    "description": "Recursive Agent Loop for Persistent Hierarchical task execution",
    "orchestrator": {
      "name": "sisyphus",
      "model": "google/antigravity-claude-opus-4-5-thinking",
      "persona": "Tireless orchestrator who breaks down complex tasks and delegates to specialists",
      "max_iterations": 45,
      "continuation": {
        "enabled": true,
        "checkpoint_interval": 5,
        "auto_resume": true,
        "state_file": ".opencode/sisyphus_state.json"
      }
    },
    "planning": {
      "strategy": "hierarchical",
      "decomposition_depth": 3,
      "parallel_branches": 4,
      "validation_gates": true
    },
    "execution": {
      "mode": "adaptive",
      "retry_policy": {
        "max_retries": 3,
        "backoff": "exponential",
        "initial_delay_ms": 1000
      },
      "timeout_ms": 300000,
      "parallel_agents": 3
    },
    "memory": {
      "working_memory_tokens": 32000,
      "long_term_store": ".opencode/memory/",
      "context_compression": true,
      "auto_summarize_at": 0.75
    },
    "hooks": {
      "on_task_start": [
        "log_task",
        "load_relevant_skills"
      ],
      "on_task_complete": [
        "update_memory",
        "notify_orchestrator"
      ],
      "on_error": [
        "log_error",
        "attempt_recovery",
        "escalate_to_human"
      ],
      "on_checkpoint": [
        "save_state",
        "compress_context"
      ]
    }
  },
  "lsp": {
    "pylsp": {
      "command": [
        "pylsp"
      ],
      "extensions": [
        ".py"
      ],
      "priority": 10,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    "typescript-language-server": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ],
      "priority": 5
    }
  }
}