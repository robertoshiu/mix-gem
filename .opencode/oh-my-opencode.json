{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "google_auth": false,
  "sisyphus_agent": {
    "default_builder_enabled": true
  },
  "background_task": {
    "defaultConcurrency": 9,
    "providerConcurrency": {
      "anthropic": 3,
      "openai": 3,
      "google": 6
    },
    "modelConcurrency": {
      "google/antigravity-claude-opus-4-5-thinking": 1,
      "google/antigravity-claude-sonnet-4-5-thinking": 2,
      "google/antigravity-claude-sonnet-4-5": 3,
      "anthropic/claude-opus-4-5": 1,
      "anthropic/claude-sonnet-4-5": 2,
      "google/antigravity-gemini-3-pro-high": 1,
      "google/antigravity-gemini-3-flash": 2,
      "openai/gpt-5.2": 2,
      "openai/gpt-5.2-codex": 2,
      "google/gemini-3-flash": 3
    }
  },
  "categories": {
    "protocol": {
      "variant": "high",
      "model": "google/antigravity-gemini-3-flash",
      "temperature": 0.1,
      "prompt_append": "Focus on HSMS/SECS-II/GEM correctness, timeouts, state models, and deterministic traceability."
    },
    "backend": {
      "model": "google/antigravity-claude-sonnet-4-5",
      "temperature": 0.1,
      "prompt_append": "Focus on FastAPI contracts, Postgres migrations, and streaming endpoints with tests."
    },
    "business-logic": {
      "model": "openai/gpt-5.2-codex",
      "variant": "xhigh",
      "temperature": 0.1
    },
    "visual": {
      "model": "opencode/minimax-m2.1-free",
      "temperature": 0.7
    }
  },
  "agents": {
    "Sisyphus": {
      "model": "google/antigravity-claude-opus-4-5-thinking",
      "variant": "max",
      "temperature": 0.3
    },
    "oracle": {
      "model": "openai/gpt-5.2",
      "variant": "xhigh",
      "temperature": 0.1
    },
    "librarian": {
      "model": "google/antigravity-claude-sonnet-4-5-thinking",
      "variant": "max",
      "temperature": 0.3
    },
    "explore": {
      "model": "opencode/grok-code"
    },
    "frontend-ui-ux-engineer": {
      "model": "opencode/minimax-m2.1-free",
      "temperature": 0.9
    },
    "document-writer": {
      "model": "google/gemini-3-flash"
    },
    "OpenCode-Builder": {
      "model": "openai/gpt-5.2",
      "variant": "xhigh",
      "temperature": 0.3
    },
    "Prometheus (Planner)": {
      "model": "google/antigravity-claude-opus-4-5-thinking",
      "variant": "max",
      "temperature": 0.45
    },
    "Metis (Plan Consultant)": {
      "model": "google/antigravity-claude-sonnet-4-5-thinking",
      "variant": "max",
      "temperature": 0.3
    },
    "Momus": {
      "model": "google/antigravity-gemini-3-flash",
      "variant": "high",
      "temperature": 0.1
    },
    "multimodal-looker": {
      "variant": "high",
      "model": "google/antigravity-gemini-3-pro"
    }
  },
  "disabled_hooks": [
    "comment-checker",
    "startup-toast"
  ],
  "ralph_loop": {
    "enabled": true,
    "description": "Recursive Agent Loop for Persistent Hierarchical task execution",
    "orchestrator": {
      "name": "sisyphus",
      "model": "openai/gpt-5.2-codex",
      "persona": "Tireless orchestrator who breaks down complex tasks and delegates to specialists",
      "max_iterations": 45,
      "continuation": {
        "enabled": true,
        "checkpoint_interval": 5,
        "auto_resume": true,
        "state_file": ".opencode/sisyphus_state.json"
      }
    },
    "planning": {
      "strategy": "hierarchical",
      "decomposition_depth": 3,
      "parallel_branches": 4,
      "validation_gates": true
    },
    "execution": {
      "mode": "adaptive",
      "retry_policy": {
        "max_retries": 3,
        "backoff": "exponential",
        "initial_delay_ms": 1000
      },
      "timeout_ms": 300000,
      "parallel_agents": 3
    },
    "memory": {
      "working_memory_tokens": 32000,
      "long_term_store": ".opencode/memory/",
      "context_compression": true,
      "auto_summarize_at": 0.75
    },
    "hooks": {
      "on_task_start": [
        "log_task",
        "load_relevant_skills"
      ],
      "on_task_complete": [
        "update_memory",
        "notify_orchestrator"
      ],
      "on_error": [
        "log_error",
        "attempt_recovery",
        "escalate_to_human"
      ],
      "on_checkpoint": [
        "save_state",
        "compress_context"
      ]
    }
  },
  "lsp": {
    "pylsp": {
      "command": [
        "pylsp"
      ],
      "extensions": [
        ".py"
      ],
      "priority": 10,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    "typescript-language-server": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ],
      "priority": 5
    }
  }
}